# Copie ce fichier en .env.local et remplis les valeurs.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : ne JAMAIS la mettre dans le code côté navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# fal.ai (fal.ai/dashboard/keys)
FAL_KEY=xxxx
# Modèle vidéo utilisé (tu peux changer plus tard)
FAL_MODEL=minimax/h3-max/text-to-video
# Modèle pour les clips suivants (démarre sur la dernière image du clip précédent)
FAL_MODEL_I2V=minimax/h3-max/image-to-video
# Résolution (optionnel) : 480P (moins cher, 0,05 $/s) ou 768P (défaut, 0,08 $/s)
# FAL_RESOLUTION=480P

# Adresse publique de ton site (pour que fal.ai puisse te prévenir)
# En local, utilise un tunnel (ex: ngrok) ; en production : https://tonsite.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mot de passe secret que fal.ai renvoie dans l'URL du webhook (invente une longue chaîne)
WEBHOOK_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Nombre de crédits pour une vidéo
CREDITS_PER_VIDEO=1

# Nom affiché sur les pages de paiement
NEXT_PUBLIC_APP_NAME=NtwaliHub Studio

# --- PAIEMENTS (étape 2) ---
# Stripe, carte bancaire en EUR (dashboard.stripe.com > Développeurs > Clés API)
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > ton endpoint > "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Flutterwave, Mobile Money Rwanda + carte en RWF (dashboard.flutterwave.com > Settings > API Keys)
FLW_SECRET_KEY=
# Flutterwave > Settings > Webhooks > "Secret hash" (un mot de passe que tu inventes)
FLW_WEBHOOK_HASH=
